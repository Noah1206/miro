{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "jsx": "preserve",
    "paths": { "@/*": ["./apps/web/*"] }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tooling/**/*.ts"
  ],
  "exclude": [
    "**/dist/**",
    "node_modules"
  ]
}
