# ── 필수 ──
# 로컬 Postgres. Supabase 를 쓰면 아래 둘 중 하나로 바꾼다 (비밀번호는 Supabase 대시보드 → Database → Connection string).
#   런타임(서버리스)  : postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   마이그레이션/시드 : postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS 와 prepared statement 설정은 호스트를 보고 자동으로 잡힌다 (packages/db/src/client.ts).
DATABASE_URL=postgres://localhost/miro_dev
# 마이그레이션 전용 연결. 비어 있으면 DATABASE_URL 을 쓴다 (6543 pooler 로는 DDL 이 불안정하다).
DIRECT_DATABASE_URL=

# 캐릭터 사진 저장 (Supabase Storage, 'character-images' 버킷 — 공개 읽기, 쓰기는 서버만).
# 대시보드 → Project Settings → Data API 에서 Project URL, → API Keys 에서 service_role 키(비밀! 절대 클라이언트에 노출 금지).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=       # Supabase Auth용 공개 키. service_role을 사용하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# ── Provider (미설정 시 Mock 으로 동작하며 UI/health 에 그 사실이 표시된다) ──
# LLM: Vercel AI Gateway. 모델은 "provider/model" 문자열 — 교체는 여기서만.
AI_GATEWAY_API_KEY=
MIRO_LLM_MODEL=              # 예: anthropic/claude-sonnet-5
# Web Push (VAPID). `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # VAPID_PUBLIC_KEY 와 같은 값 (클라이언트 노출)

# ── 스케줄러 (Vercel Cron 이 Authorization: Bearer 로 보낸다) ──
CRON_SECRET=

# ── 운영자 최초 시드 (`pnpm --filter @miro/db seed:admin`) ──
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROLE=superadmin

# ── 개발/E2E 전용. 운영에서는 절대 1 로 두지 않는다 ──
MIRO_ENABLE_DEV_API=0

# ── 소셜 로그인 ──
AUTH_PROVIDER=                # supabase: 위 Project URL/Publishable key와 대시보드의 Auth Provider 사용
# 비워 두면 아래 직접 OAuth 설정을 사용한다. 이 경우 키가 없으면 개발용 시뮬레이션.
# 카카오: CLIENT_ID 는 REST API 키. CLIENT_SECRET 은 [보안] 탭에서 생성 후 '사용함' 으로 켜야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# E2E 전용. 1 이면 키가 있어도 소셜 로그인을 시뮬레이션으로 돌린다 (테스트는 실제 계정으로 로그인할 수 없다).
# 실제 배포(VERCEL_ENV=production)에서는 무시된다.
MIRO_MOCK_OAUTH=
# 콜백 URL 의 기준 origin. 비우면 요청 origin. 예: https://miro.app
AUTH_BASE_URL=

# ── AI Provider — 코드는 어느 모델에도 묶이지 않는다. 이름 하나로 고르고, 둘째는 fallback ──
# gemini | cloudflare | gateway | openai | anthropic | miro-slm. 둘 다 비우면 정해진 대사(mock) 로 흐름만 돈다.
AI_PROVIDER=
AI_FALLBACK_PROVIDER=
AI_TIMEOUT_MS=20000
GEMINI_API_KEY=
GEMINI_MODEL=                   # 비우면 gemini-2.5-flash-lite
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=            # 비우면 @cf/meta/llama-3.1-8b-instruct
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=                # 로컬 OpenAI 호환 서버도 여기로

# ── Budget Guard — 비우면 안전한 기본값 적용. 0은 실제 0 한도 ──
AI_DAILY_BUDGET=0               # 실 비용을 모르면 호출 차단. 무료라고 자동 0원 처리하지 않음
AI_DAILY_REQUEST_LIMIT=300      # 하루 전체 요청 수
AI_USER_DAILY_LIMIT=200         # 사용자 하루 실제 inference 시도 수 (retry/fallback 포함)
AI_IP_RATE_LIMIT_PER_MINUTE=8   # IP 1분

# ── 모드/기능 플래그 — alpha 면 사진·통화·Live Scene 을 끄고 관계·기억·사건·리얼리티는 켠다 ──
MIRO_MODE=production            # alpha | production
# MIRO_FEATURE_IMAGE_GENERATION=1   개별 기능 덮어쓰기 (1|0)

# ── Production AI Platform: docs/MIRO_AI_PLATFORM.md ──
# 모든 모델 설정은 서버 전용 JSON. 별칭/역할/가격/컨텍스트/버전은 한 곳에서 관리.
# 실 모델은 providerModelId와 API key를 설정하고 inputCost/outputCost(USD/1M tokens)를 명시.
# 아래는 외부 API를 호출하지 않는 개발용 예시. 실 모델의 가격을 검증한 뒤 교체.
MIRO_MODEL_REGISTRY='[{"id":"small-dialogue","provider":"mock","providerModelId":"mock","tier":"small","capabilities":["dialogue","semantic_event","relationship_analysis","memory_extraction","memory_summary","event_generation","world_update","image_prompt","moderation"],"inputCost":0,"outputCost":0,"maxContextTokens":32768,"maxOutputTokens":1024,"version":"mock-v1","enabled":true,"trainingAllowed":false}]'
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MIRO_SLM_URL=                   # 예: http://private-inference:8000/v1
MIRO_SLM_API_KEY=
MIRO_SLM_MODEL=                 # 예: miro-router-v1
MIRO_USAGE_POLICY=             # JSON: monthly, weights, continuity; config/ai-policy.ts 기본값
MIRO_BUDGET_POLICY=            # JSON: global/user/ip/plan:free/provider:gemini/model:<alias>
MIRO_MEDIA_COSTS=              # JSON: photo/background/live_scene/face_cast 별 요청당 USD 상한
MIRO_REQUESTS_PER_MINUTE=20
MIRO_PROMPT_EXPERIMENTS=        # 예: {"dialogue":{"version":"v2","percent":5}}
MIRO_CANARY_MODEL=
MIRO_CANARY_PERCENT=0
MIRO_CANARY_APPROVED=0          # Golden + 사람 평가를 통과한 뒤에만 1
MIRO_MODEL_ROLLBACK=0           # 1이면 Canary와 Shadow를 즉시 중단
MIRO_SHADOW_MODEL=              # 별도 평가 동의가 있는 사용자만, 2초 한도, 사용자 응답에는 미반영
MIRO_EVAL_SAMPLE_PERCENT=0      # 원문 로그와 분리, 평가 동의 + 가림 처리 후 30일 보관
# 선택적 보조 작업: 같은 월간 사용량에서 차감. 처음에는 비용 없이 규칙 분류만 사용.
MIRO_FEATURE_LLM_SEMANTIC_ANALYSIS=0
MIRO_FEATURE_MEMORY_EXTRACTION=0
MIRO_FEATURE_MEMORY_SUMMARIES=0
