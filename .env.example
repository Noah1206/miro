# ── 필수 ──
# 로컬 Postgres. Supabase 를 쓰면 아래 둘 중 하나로 바꾼다 (비밀번호는 Supabase 대시보드 → Database → Connection string).
#   런타임(서버리스)  : postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   마이그레이션/시드 : postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# TLS 와 prepared statement 설정은 호스트를 보고 자동으로 잡힌다 (packages/db/src/client.ts).
DATABASE_URL=postgres://localhost/miro_dev
# 마이그레이션 전용 연결. 비어 있으면 DATABASE_URL 을 쓴다 (6543 pooler 로는 DDL 이 불안정하다).
DIRECT_DATABASE_URL=

# ── Provider (미설정 시 Mock 으로 동작하며 UI/health 에 그 사실이 표시된다) ──
# LLM: Vercel AI Gateway. 모델은 "provider/model" 문자열 — 교체는 여기서만.
AI_GATEWAY_API_KEY=
MIRO_LLM_MODEL=              # 예: anthropic/claude-sonnet-5
# Web Push (VAPID). `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # VAPID_PUBLIC_KEY 와 같은 값 (클라이언트 노출)

# ── 스케줄러 (Vercel Cron 이 Authorization: Bearer 로 보낸다) ──
CRON_SECRET=

# ── 운영자 최초 시드 (`pnpm --filter @miro/db seed:admin`) ──
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_ROLE=superadmin

# ── 개발/E2E 전용. 운영에서는 절대 1 로 두지 않는다 ──
MIRO_ENABLE_DEV_API=0

# ── 소셜 로그인 (하나라도 비어 있으면 그 제공자는 개발용 시뮬레이션으로 동작) ──
# 카카오: CLIENT_ID 는 REST API 키. CLIENT_SECRET 은 [보안] 탭에서 생성 후 '사용함' 으로 켜야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 콜백 URL 의 기준 origin. 비우면 요청 origin. 예: https://miro.app
AUTH_BASE_URL=
