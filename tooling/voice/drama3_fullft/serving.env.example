# Fill these on the private GPU host after a trained checkpoint passes evaluation.
MIRO_VOICE_CHECKPOINT=/models/miro-drama3-ko-fullft-v1
MIRO_VOICE_DEVICES=cuda:0,cuda:1
MIRO_VOICE_BIND=127.0.0.1:8788
# Set an actual secret in the host environment; no key is committed here.
MIRO_VOICE_API_KEY=

# CPU gateway forwards app /speak requests to the private native server.
MIRO_VOICE_URL=http://127.0.0.1:8788
MIRO_TTS_GATEWAY_PORT=8789
MIRO_TTS_API_KEY=
MIRO_TTS_VOICE_REGISTRY_FILE=/models/miro-voice-registry.json
# Optional explicit default; unknown voice IDs are always rejected.
MIRO_TTS_DEFAULT_VOICE=
# On Miro web only: point at the HTTPS CPU gateway, never expose these keys to browsers.
# MIRO_TTS_URL=https://your-private-voice-gateway
