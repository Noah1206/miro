{
  "name": "miro",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @miro/web dev",
    "build": "pnpm --filter @miro/web build && pnpm --filter @miro/admin build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false",
    "db:generate": "pnpm --filter @miro/db generate",
    "db:migrate": "pnpm --filter @miro/db migrate",
    "e2e": "playwright test",
    "db:migrate:sql": "set -e; for f in packages/db/migrations/*.sql; do psql -X -v ON_ERROR_STOP=1 --single-transaction -q \"$DATABASE_URL\" -f \"$f\"; done",
    "db:seed": "tsx packages/db/seed.ts",
    "db:seed:admin": "tsx packages/db/seed-admin.ts",
    "ai:eval": "tsx ai/evals/run.ts",
    "ai:cost": "tsx ai/evals/chat-cost.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10",
    "@playwright/test": "1.49",
    "@types/node": "^22.10.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
